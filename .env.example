# copy to .env (git-ignored). Read by Spring when run from the IDE (spring.config.import) and by docker compose.
# MySQL comes from ../docker-dependencies. These are the host-side values; compose points the container at mysql:3306 itself.
DB_URL=jdbc:mysql://localhost:3306/payment?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=password
# must match MYSQL_ROOT_PASSWORD in ../docker-dependencies/.env when run through docker compose
MYSQL_ROOT_PASSWORD=password

# Stripe sandbox (see readme / docs/stripe-transfer.md)
PAYMENT_GATEWAY_MODE=stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PAYOUT_MODE=sandbox-transfer
STRIPE_SANDBOX_HOST_ACCOUNT_ID=acct_replace_me
# Explicitly enables POST /internal/dev/stripe/transfers; sandbox keys only.
STRIPE_TEST_TRANSFER_ENABLED=false

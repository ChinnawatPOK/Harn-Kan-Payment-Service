# Deal Service gRPC, used for the UpdateParticipantPayment callback.
DEAL_SERVICE_HOST=localhost
DEAL_SERVICE_PORT=9090

# Stripe sandbox transfers: all creators use one connected account.
PAYMENT_GATEWAY_MODE=stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PAYOUT_MODE=sandbox-transfer
STRIPE_SANDBOX_HOST_ACCOUNT_ID=acct_replace_me
# Explicitly enables POST /internal/dev/stripe/transfers; sandbox keys only.
STRIPE_TEST_TRANSFER_ENABLED=false

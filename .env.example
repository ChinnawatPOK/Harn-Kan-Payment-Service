# Copy to .env (ignored by Git), then fill the values locally.
# Spring Boot reads .env when started from this repository; environment variables override it.
PAYMENT_GATEWAY_MODE=stripe
PAYMENT_DEV_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_me
# Used by the mobile app; backend does not expose this key.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Use the whsec value printed by your current `stripe listen` listener.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional infrastructure overrides:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/payment?serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=replace_me
# DEAL_GRPC_TARGET=localhost:9090
# RABBITMQ_HOST=localhost

# Optional: real Stripe API transfers inside sandbox only (no bank payout).
# Enable Connect and create a test connected account first; then select sandbox-transfer.
STRIPE_PAYOUT_MODE=ledger
STRIPE_SANDBOX_HOST_ACCOUNT_ID=
